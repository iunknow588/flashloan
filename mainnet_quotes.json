  <header>
    <h1>DEX 报价与路由</h1>
    <nav>
      <a data-surface-link href="/dex">报价</a>
      <a data-surface-link href="/dex/overview">总览</a>
      <a data-surface-link href="/dex/market-observation">市场观察</a>
      <a data-surface-link href="/dex/candidates">候选池</a>
      <a data-surface-link href="/dex/submissions">提交记录</a>
    </nav>
  </header>
  <main>
    <div class="toolbar">
      <button id="refreshBtn" type="button">刷新路由</button>
      <button id="resetStatsBtn" type="button">清零统计</button>
      <label for="refreshInterval">刷新间隔（秒）</label>
      <input id="refreshInterval" type="number" min="10" max="3600" step="1" value="180" inputmode="numeric">
      <label><input id="autoExecuteToggle" type="checkbox"> 自动扫描复核并进行链上广播</label>
      <span id="message" class="muted">等待数据</span>
    </div>
    <section class="grid">
      <div class="metric"><small>路线数量</small><strong id="routeCount">-</strong><span id="routeSourceMeta">市场观察</span></div>
      <div class="metric"><small>1000U 探测</small><strong id="completeCount">-</strong><span id="probeMeta">链上 AMM 验证</span></div>
      <div class="metric"><small>链上复核候选</small><strong id="readyCount">-</strong><span id="profitMeta">已扣除闪电贷和 Gas 成本</span></div>
      <div class="metric"><small>可自动执行闭环</small><strong id="autoExecutableCount">-</strong><span id="autoExecutableMeta">链上复核通过且可盈利</span></div>
      <div class="metric"><small>链上复核总数</small><strong id="reviewedCount">-</strong><span id="reviewedMeta">本轮已完成链上复核</span></div>
      <div class="metric"><small>闭环扫描</small><strong id="closedLoopScanCount">-</strong><span id="closedLoopScanMeta">累计已完成闭环刷新</span></div>
      <div class="metric"><small>链上复核次数</small><strong id="closedLoopReviewCount">-</strong><span id="closedLoopReviewMeta">累计链上复核尝试</span></div>
      <div class="metric"><small>正盈利空间</small><strong id="profitableCount">-</strong><span id="profitableMeta">链上复核正收益</span></div>
      <div class="metric"><small>已自动执行</small><strong id="autoExecutedCount">-</strong><span id="autoExecutedMeta">已广播链上交易</span></div>
      <div class="metric"><small>上链广播</small><strong id="autoBroadcastCount">-</strong><span id="autoBroadcastMeta">累计已广播链上交易</span></div>
      <div class="metric"><small>正在排队</small><strong id="queueCount">-</strong><span id="queueMeta">待复核/待扫描</span></div>
      <div class="metric"><small>结算</small><strong id="settlement">-</strong><span id="settlementMeta">-</span></div>
    </section>
    <section id="groupList" class="group-panel"></section>
    <section id="routeList"></section>
  </main>
  <script src="/static/dex_quotes/route_state_machine.js"></script>
  <script src="/static/dex_quotes/route_offchain.js"></script>
  <script src="/static/dex_quotes/route_preflight.js"></script>
  <script src="/static/dex_quotes/route_execution.js"></script>
  <script src="/static/dex_quotes/quotes_render.js"></script>
  <script src="/static/dex_quotes/quotes_app.js"></script>
</body>
</html>
