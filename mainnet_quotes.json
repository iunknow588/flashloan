  .app-shell-chain-control { grid-column: 3; grid-row: 1; align-self: start; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 6px; width: 100%; min-width: 0; }
  .app-shell-protocol-control { grid-column: 4; grid-row: 1; align-self: start; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 6px; width: 100%; min-width: 0; overflow: hidden; }
  .app-shell-protocol-line { display: flex; align-items: center; gap: 8px; width: 100%; min-width: 0; min-height: 38px; }
