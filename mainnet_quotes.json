<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DEX 报价与路由</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, "Microsoft YaHei", sans-serif; color: #17202a; background: #f6f7f9; }
    header, main { padding: 18px 24px; }
    header { display: flex; justify-content: space-between; gap: 12px; background: #fff; border-bottom: 1px solid #d9dee7; }
    main { width: min(1420px, 100%); margin: 0 auto; }
    h1 { margin: 0; font-size: 20px; }
    h2 { margin: 0 0 8px; font-size: 16px; }
    nav { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    nav a { color: #0f766e; font-weight: 700; text-decoration: none; }
    button { min-height: 36px; border: 1px solid #0f766e; border-radius: 6px; padding: 0 12px; background: #0f766e; color: #fff; font-weight: 700; cursor: pointer; }
    button.copy-btn { min-height: 30px; border-color: #d0d5dd; background: #fff; color: #344054; font-size: 12px; }
    .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .metric, .route { border: 1px solid #d9dee7; border-radius: 8px; background: #fff; padding: 14px; }
    .group-panel { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; margin-bottom: 16px; }
    .group-card { border: 1px solid #d9dee7; border-radius: 8px; background: #fff; padding: 12px; }
    .group-card h3 { margin: 0 0 6px; font-size: 15px; }
    .group-card small { color: #667085; }
    .group-card strong { display: block; margin-top: 6px; font-size: 13px; }
    .metric small { display: block; color: #667085; margin-bottom: 7px; }
    .metric strong { display: block; font-size: 18px; }
    .metric span, .muted { color: #667085; font-size: 13px; }
    .route { margin-bottom: 12px; }
    .route-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .route-test { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 10px 0; padding: 10px; border: 1px solid #e4e7ec; border-radius: 6px; background: #fafafa; }
    .route-test input { min-height: 36px; width: 160px; border: 1px solid #d0d5dd; border-radius: 6px; padding: 0 10px; font-size: 13px; }
    .route-test button { min-height: 32px; font-size: 12px; }
    .route-test-result { flex: 1 1 100%; overflow-wrap: anywhere; color: #667085; font-size: 12px; }
    .badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
    .badge { display: inline-block; padding: 3px 8px; border-radius: 6px; background: #eef6f4; color: #0f766e; font-weight: 700; font-size: 12px; }
    .badge.good { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .badge.warn { background: #fff7ed; color: #b45309; border: 1px solid #fed7aa; }
    .badge.bad { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
    .analysis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin: 10px 0; }
    .analysis div { border: 1px solid #e4e7ec; border-radius: 6px; padding: 8px; background: #fafafa; }
    .analysis small { display: block; color: #667085; margin-bottom: 4px; }
    .analysis strong { font-size: 14px; }
    .table-wrap { overflow-x: auto; margin-top: 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th, td { border-bottom: 1px solid #e4e7ec; padding: 8px; text-align: right; white-space: nowrap; }
    th:first-child, td:first-child { text-align: left; }
    .recommendation, .onchain-evidence { margin-top: 10px; padding: 10px; border-radius: 6px; border: 1px solid #e4e7ec; background: #f8fafc; }
    .onchain-evidence { display: grid; gap: 5px; border-color: #fecaca; background: #fff7f7; }
    .onchain-evidence.good { border-color: #bbf7d0; background: #f0fdf4; }
    .evidence-error { color: #b91c1c; font-weight: 700; overflow-wrap: anywhere; }
    .error-chain { margin-top: 4px; padding-left: 4px; border-left: 3px solid #b91c1c; font-size: 12px; }
    .error-chain ol { margin: 4px 0 0 0; padding-left: 18px; }
    .error-chain li { margin: 2px 0; overflow-wrap: anywhere; }
    ol { margin: 8px 0 0 18px; padding: 0; color: #344054; line-height: 1.55; }
    .empty { padding: 18px; color: #667085; background: #fff; border: 1px solid #d9dee7; border-radius: 8px; }
    .pool-group { margin-bottom: 18px; border: 1px solid #d9dee7; border-radius: 8px; background: #fff; padding: 12px; }
    .pool-group > header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
    .pool-group h2 { margin: 0; font-size: 15px; }
    .pool-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .pool-chip { border: 1px solid #d9dee7; border-radius: 6px; background: #f8fafc; padding: 4px 8px; font-size: 12px; color: #344054; }
    .pool-chip small { display: block; color: #667085; }
    .route-in-group { border-top: 1px solid #e4e7ec; padding: 10px 0; }
    .route-in-group + .route-in-group { margin-top: 8px; }
    .route-in-summary { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
    .route-in-summary .path-text { flex: 1 1 260px; min-width: 0; overflow-wrap: anywhere; font-weight: 700; }
    .route-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .route-actions input { min-height: 30px; width: 110px; border: 1px solid #d0d5dd; border-radius: 6px; padding: 0 8px; font-size: 12px; }
    .route-actions button { min-height: 30px; font-size: 12px; padding: 0 10px; }
    .route-hop-line { margin-top: 6px; color: #344054; font-size: 12px; overflow-wrap: anywhere; }
    .route-metric-line { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; color: #667085; font-size: 12px; }
    @media (max-width: 860px) { header { display: block; } nav { margin-top: 10px; } .route-head { display: block; } .pool-group > header { display: block; } }
  </style>
</head>
