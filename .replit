entrypoint = "run_replit.py"
modules = ["python-3.11"]
run = "python3 run_replit.py"

[env]
PYTHONUNBUFFERED = "1"
PIP_DISABLE_PIP_VERSION_CHECK = "1"

[nix]
channel = "stable-24_05"

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "run_replit.py"]
deploymentTarget = "cloudrun"
