{
  "schema_version": "chain-flow-v1",
  "network": "polygon",
  "chain_id": 137,
  "isolation": {
    "scope_fields": ["network", "chain_id", "market_id"],
    "forbid_cross_chain_fallback": true,
    "forbidden_source_networks": ["ethereum", "bnb", "avalanche-testnet", "avalanche", "robinhood", "robinhood-testnet", "local-hardhat"],
    "forbidden_source_chain_ids": [1, 56, 43113, 43114, 4663, 46630, 31337]
  },
  "flows": {
    "flash_loan_pools": {
      "handler": "intent_trade.chains.polygon.flash_loan_pools:flash_loan_pool_protocol_view",
      "allowed_protocols": ["aave_v3", "uniswap_v3", "quickswap_v2"],
      "data_file_keys": ["pool_discovery"],
      "requires_scope_match": true
    },
    "dex_pool_candidates": {
      "handler": "intent_trade.chains.polygon.dex_pool_candidates:dex_pool_candidates_payload",
      "allowed_protocols": ["uniswap_v3", "uniswap_v4", "quickswap_v2", "balancer_v2"],
      "data_file_keys": ["pool_discovery"],
      "requires_scope_match": true,
      "missing_evidence_policy": "close_gate"
    },
    "pool_discovery": {
      "handler": "chain_specific_placeholder",
      "allowed_protocols": ["aave_v3", "uniswap_v3", "uniswap_v4", "quickswap_v2", "balancer_v2"],
      "data_file_keys": ["pool_discovery"],
      "requires_scope_match": true
    }
  }
}
