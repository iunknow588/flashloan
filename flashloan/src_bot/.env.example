# 本文件是配置模板。复制为 .env 后再填写真实值。
# Replit 部署时优先使用 Secrets；本地运行时读取 .env。
# 真实密钥、数据库密码、私有 RPC URL 不要提交到 git。

# PostgreSQL/Neon 连接串。控制面板、观察数据、清算账号池和扫描历史都依赖它。
DATABASE_URL=postgresql://user:password@host:555555/database

# PostgreSQL 连接池。排查连接生命周期问题时可临时改为 false。
DATABASE_POOL_ENABLED=true
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10

# 主 Avalanche C-Chain RPC。控制面板、Aave 读取、Borrow 事件扫描优先使用它。
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc

# 兼容 contract/contracts-bot/Hardhat 的 RPC 变量名。和 AVALANCHE_RPC 可以填同一个地址。
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Avalanche RPC 备用列表，逗号分隔。主 RPC 失败时按顺序尝试。
AVALANCHE_RPCS=https://api.avax.network/ext/bc/C/rpc,https://rpc.ankr.com/avalanche,https://avalanche-c-chain-rpc.publicnode.com

# Pinax credentials for Avalanche V3 pool discovery.
# Token API pool metadata requests use Authorization: Bearer <PINAX_JWT>.
# RPC requests use the API key in the URL path, for example:
#   https://<network>.rpc.pinax.network/v1/<PINAX_API_KEY>/
# The values below are intentionally invalid sample credentials that show the expected format.
# Replace them in .env or deployment secrets with active Pinax credentials.
PINAX_API_KEY_ID=7d367587-8f6d-4914-b853-efbf399635ef
PINAX_API_KEY=4dcf894b3283303a8c6ebd037fdcd2a9646896d86ffaecd9
PINAX_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..n0TV-_XXbc5e3hKYvSuQ9-SdxxAs55SKO91BEzimWM0
PINAX_TOKEN_API_BASE_URL=https://api.pinax.network
PINAX_EVM_POOLS_URL=https://api.pinax.network/v1/evm/pools
PINAX_RPC_URL_TEMPLATE=https://<network>.rpc.pinax.network/v1/<PINAX_API_KEY>/
PINAX_AVALANCHE_RPC_URL=https://avalanche.rpc.pinax.network/v1/<PINAX_API_KEY>/
PINAX_POOL_DISCOVERY_NETWORK=avalanche
PINAX_POOL_DISCOVERY_PROTOCOLS=uniswap_v3
PINAX_POOL_DISCOVERY_CACHE_FILE=runtime/cache/avalanche_v3_pools.json
PINAX_POOL_DISCOVERY_CACHE_SECONDS=86400
PINAX_POOL_DISCOVERY_REQUEST_TIMEOUT_SECONDS=20

# Triangular runtime V3 controller.
# Pool candidates are loaded from the local discovery cache and passed as runtime calldata.
# Keep executor mode disabled until the selected testnet route, router and amounts are verified.
UNIFIED_EXECUTOR_ADDRESS=
UNIFIED_EXECUTOR_ARTIFACT=..\..\contract\contracts-dex\artifacts\src\UnifiedFlashLoanMevExecutor.sol\UnifiedFlashLoanMevExecutor.json
TRIANGULAR_RUNTIME_POOL_CACHE_FILE=runtime/cache/avalanche_v3_pools.json
TRIANGULAR_DIRECT_EXECUTE_RUNTIME_TRADE=false
TRIANGULAR_DIRECT_EXECUTION_MODE=ordered_auto
# 0 表示扫描缓存中全部 route group；正数表示本轮最多预演多少组。
TRIANGULAR_RUNTIME_ROUTE_GROUP_LIMIT=25
TRIANGULAR_BORROW_AMOUNT_UNITS=100000000
TRIANGULAR_EXECUTION_AMOUNT_USDC_BASE_UNITS=100000000
TRIANGULAR_AMOUNT_OUT_MIN_USDC=100000000
TRIANGULAR_MIN_PROFIT_USDC_BASE_UNITS=1
TRIANGULAR_CROSS_POOL_BORROW_AMOUNT_UNITS=100000000
TRIANGULAR_CROSS_POOL_MIN_FINAL_TOKEN_X=100000000
TRIANGULAR_CROSS_POOL_MIN_PROFIT_TOKEN_X_BASE_UNITS=1
TRIANGULAR_EXECUTION_DEADLINE_SECONDS=300
TRIANGULAR_DIRECT_BROADCAST_ENABLED=false
UNIFIED_EXECUTOR_BROADCAST_ENABLED=false
AVAX_USDC_PRICE=
AVAX_USDC_PRICE_UPDATED_AT=
AVAX_USDC_PRICE_MAX_AGE_SECONDS=120
TRIANGULAR_CACHE_RISK_PENALTY_USDC=0
TRIANGULAR_CACHE_RISK_PENALTY_PER_BLOCK_USDC=0

# 合约门禁证据脚本。fork 演练必须使用本地 Hardhat fork，不向主网发送交易。
# AVALANCHE_FORK_RPC_URL 设置后，npm run fork:unified:avalanche 会在 --network hardhat 下 fork Avalanche。
AVALANCHE_FORK_RPC_URL=
AVALANCHE_FORK_BLOCK_NUMBER=
UNIFIED_EXECUTOR_DEPLOYMENT_FILE=
UNIFIED_FORK_RUNTIME_TRADES_FILE=
UNIFIED_FORK_RUNTIME_TRADES_JSON=
UNIFIED_FORK_USDC_AMOUNT=100000000
UNIFIED_FORK_AMOUNT_OUT_MIN_USDC=0
UNIFIED_FORK_MIN_PROFIT_USDC=1
UNIFIED_FORK_FAILURE_MIN_PROFIT_USDC=999999999999999999999999
UNIFIED_FORK_ENABLE_NON_USDC_CROSS_POOL=false

# UnifiedFlashLoanMevExecutor uses five fixed ordered slots:
# 0 = U-X, 1 = U-Y, 2 = X-Y, 3 = Y-X fallback.
# The bot selects one coherent X/Y route group before calling the contract.

# CoW Protocol network is operation-scoped, not a global system setting.
# Current CoW test quote flow defaults to Sepolia; pass cow_network/--cow-network for a specific run.

# Aave V3 Avalanche Pool 地址。用于读取账户健康度和发现 Borrow 事件。
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1db02a252b5b4814aD
FUJI_AAVE_POOL_ADDRESS=0x8B9b2AF4afB389b4a70A474dfD4AdCD4a302bb40
FUJI_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# Aave Protocol Data Provider 地址。用于读取用户每个 reserve 的抵押、稳定债、可变债。
AAVE_PROTOCOL_DATA_PROVIDER_ADDRESS=0x243Aa95cAC2a25651eda86e80bEe66114413c43b

# Aave Liquidation Data Provider 地址。用于读取 maxDebtToLiquidate、amountToPassToLiquidationCall 等清算参数。
AAVE_LIQUIDATION_DATA_PROVIDER_ADDRESS=

# 运行时目录。状态文件、缓存、日志、样本库默认写在这个目录下面。
FLASHLOAN_RUNTIME_DIR=runtime

# Aave reserve 资产缓存文件路径。保存 Aave 资产与 Binance 交易对的映射结果。
AAVE_RESERVE_CACHE_FILE=runtime/cache/aave_reserve_assets.json

# Aave reserve 缓存有效期，单位秒。过期后会重新读取链上 reserve 列表。
AAVE_RESERVE_CACHE_SECONDS=3600

# 最多加载的 Aave reserve 数量。通常 1000 已足够覆盖 Avalanche Aave 市场。
AAVE_RESERVE_SYMBOL_LIMIT=1000

# 统一闪电贷 direct-onchain 熔断状态文件。广播前会检查，失败后会持久化计数。
DIRECT_ONCHAIN_CIRCUIT_BREAKER_FILE=runtime/cache/direct_onchain_circuit_breaker.json
DIRECT_ONCHAIN_CIRCUIT_BREAKER_ENABLED=true

# 链下门禁失败达到该次数后暂停该 route group，默认黄色暂停。
DIRECT_ONCHAIN_CIRCUIT_OFFCHAIN_THRESHOLD=5

# 已提交/已上链失败达到该次数后暂停该 route group，默认橙色暂停。
DIRECT_ONCHAIN_CIRCUIT_ONCHAIN_THRESHOLD=2

# 单次估算损失达到该 USDC 数量时进入红色暂停。单位为 USDC 十进制值。
DIRECT_ONCHAIN_CIRCUIT_RED_LOSS_USDC=1

# 黄色/橙色/红色暂停冷却秒数。恢复前仍需重新刷新缓存和预演。
DIRECT_ONCHAIN_CIRCUIT_COOLDOWN_SECONDS=3600

# Binance WebSocket 基础地址列表，逗号分隔。观察器会按列表尝试连接。
BINANCE_WS_BASES=wss://stream.binance.com:9443,wss://data-stream.binance.vision:443
BINANCE_WS_OPEN_TIMEOUT_SECONDS=5

# Binance REST 基础地址列表，逗号分隔。WebSocket 不可用时用于补价格。
BINANCE_REST_BASES=https://api.binance.com,https://data-api.binance.vision
BINANCE_REST_TIMEOUT_SECONDS=5
BINANCE_SYMBOLS_FAST_PRICE_LIST=true

# Binance REST 轮询间隔，单位秒。只在 REST fallback 路径中使用。
BINANCE_REST_POLL_SECONDS=3

# 可选 HTTP 代理。REST 请求可使用标准代理变量。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 手工指定观察交易对，逗号分隔。部分选择模式会覆盖或补充这个列表。
SYMBOLS=AVAXUSDT,ETHUSDT,BTCUSDT,AAVEUSDT,USDCUSDT

# 行情采样周期，单位秒。越小越敏感，但 CPU/网络压力越大。
SAMPLE_SECONDS=1.0

# Aave/Binance 观察结果写入数据库的间隔，单位秒。
OBSERVATION_WRITE_SECONDS=1

# Aave 链上价格/数据轮询间隔，单位秒。
AAVE_POLL_SECONDS=1

# 控制台日志/状态摘要输出间隔，单位秒。
REPORT_SECONDS=2

# 数据过期阈值，单位秒。超过该时间未更新会被视为 stale。
STALE_SECONDS=30

# 价差告警阈值，单位百分比。超过该阈值才标记为 alert。
ALERT_DIFF_PERCENT=0.30

# 是否只输出告警项。false 表示普通观察数据也会输出。
REPORT_ONLY_ALERTS=false

# Binance/Aave 观察篮子选择模式：
# market_cap: CoinGecko 市值排序映射到 Binance USDT。
# movers: Binance 24h 涨跌榜，不适合短窗口速度测试。
# all_usdt/velocity: Binance 全部 USDT 交易对，受 BINANCE_TOP_SYMBOL_LIMIT 限制。
# usdc_pools/stable_pools/aave_borrow_pools: 按 DEX 池或 Aave 可借资产生成。
# aave_binance_overlap: Aave reserve 与 Binance USDT 的交集。
BINANCE_SYMBOL_SELECTION=aave_binance_overlap

# Binance 交易对数量上限。0 表示不限制。
BINANCE_TOP_SYMBOL_LIMIT=0

# 涨速/跌速两侧各保留多少个候选。100 表示 top 100 + bottom 100。
BINANCE_VELOCITY_SIDE_LIMIT=100

# 每个 Binance WebSocket 连接承载的交易对数量。
BINANCE_WS_CHUNK_SIZE=200

# Binance 24h quote volume 最小过滤阈值，单位 USDT。0 表示不过滤。
BINANCE_MIN_QUOTE_VOLUME_USDT=0

# Binance 短窗口扫描档位：200ms / 500ms / 1000ms / 3000ms / custom。
# 200ms 更灵敏但更吃 CPU/写库；1000ms 是当前默认观察档；custom 使用下面的单项配置。
BINANCE_SCAN_PROFILE=1000ms

# 涨跌幅计算窗口，单位秒。用于短窗口分歧观察。
# BINANCE_SCAN_PROFILE=custom 时使用这个值。
BINANCE_CHANGE_WINDOW_SECONDS=1.0

# 速度候选最小涨跌幅，单位百分比。
BINANCE_VELOCITY_MIN_CHANGE_PERCENT=0.2

# 市场分歧触发阈值。a*b/观察篮子数量超过该值才计算全币对纸面利润。
MARKET_DIVERGENCE_TRIGGER_MIN=1.0

# 上涨侧触发阈值，单位百分比。
TRIGGER_MIN_UP_CHANGE_PERCENT=0.05

# 下跌侧触发阈值，单位百分比。
TRIGGER_MIN_DOWN_CHANGE_PERCENT=0.05

# Binance 极值快照写入数据库间隔，单位秒。
# BINANCE_SCAN_PROFILE=custom 时使用这个值。
BINANCE_EXTREME_WRITE_SECONDS=1.0

# 写库时 top/bottom 两侧各保留多少个候选。
BINANCE_CANDIDATE_DB_SIDE_LIMIT=10

# Binance 候选币对价格写入间隔，单位秒。
# BINANCE_SCAN_PROFILE=custom 时使用这个值。
BINANCE_PAIR_PRICE_WRITE_SECONDS=1.0

# Binance 候选币对价格批量刷新到数据库的间隔，单位秒。
BINANCE_PAIR_PRICE_FLUSH_SECONDS=5

# 是否把普通观察记录写入数据库。false 可减少数据库写入压力。
OBSERVATION_DB_WRITES=false

# DEX 稳定币目标缓存文件路径。
DEX_STABLE_TARGET_CACHE_FILE=runtime/cache/dex_stable_targets.json

# DEX 稳定币目标缓存有效期，单位秒。
DEX_STABLE_TARGET_CACHE_SECONDS=3600

# 稳定币目标 token 列表，格式 SYMBOL:address，逗号分隔。
DEX_TARGET_STABLE_TOKENS=USDC:0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E,USDT:0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7,USDC.e:0xA7D7079b0FEaD91F3e65f86E8915Cb59c1a4C664,USDT.e:0xc7198437980c041c805A1EDcbA50c1Ce5db95118,DAI.e:0xd586E7F844cEa2F87f50152665BCbc2C279D8d70

# DEX 稳定币池扫描起始区块。0 表示从创世/最早可用块开始。
DEX_STABLE_POOL_FROM_BLOCK=0

# DEX 稳定币池事件扫描分块大小。
DEX_STABLE_POOL_SCAN_CHUNK_SIZE=50000

# DEX 可借目标缓存文件路径。
DEX_BORROW_TARGET_CACHE_FILE=runtime/cache/dex_borrow_targets.json

# DEX 可借目标缓存有效期，单位秒。
DEX_BORROW_TARGET_CACHE_SECONDS=3600

# DEX 可借目标来源。dexscreener 表示使用 DexScreener API/缓存数据。
DEX_BORROW_TARGET_SOURCE=dexscreener

# DEX 可借池扫描起始区块。0 表示从最早可用块开始。
DEX_BORROW_POOL_FROM_BLOCK=0

# DEX 可借池事件扫描分块大小。
DEX_BORROW_POOL_SCAN_CHUNK_SIZE=50000

# 是否自动发现 Aave 借款账号。false 时只使用手工/数据库已有账号池。
LIQUIDATION_AUTO_DISCOVER_ACCOUNTS=true

# recent 模式向前扫描多少天内的 Borrow 事件。
LIQUIDATION_RECENT_DISCOVERY_DAYS=7

# historical-backfill 每轮向历史回补多少天。
LIQUIDATION_BACKFILL_WINDOW_DAYS=7

# 历史回补最小间隔，单位秒。
LIQUIDATION_BACKFILL_INTERVAL_SECONDS=3600

# Borrow 事件扫描每个 RPC getLogs 的区块块数。
LIQUIDATION_BORROW_SCAN_CHUNK_SIZE=1000

# 每轮最多保存/返回多少个新发现借款账号。不会截断区块扫描，只限制账号数量。
LIQUIDATION_BORROW_DISCOVERY_LIMIT=5000

# 可选的外部借款人索引粗筛。开启后只产生候选账号，最终仍以链上健康度扫描复核。
LIQUIDATION_EXTERNAL_INDEX_ENABLED=false
LIQUIDATION_EXTERNAL_INDEX_URL=
LIQUIDATION_EXTERNAL_INDEX_METHOD=POST
LIQUIDATION_EXTERNAL_INDEX_TIMEOUT_SECONDS=8
LIQUIDATION_EXTERNAL_INDEX_LIMIT=5000
LIQUIDATION_EXTERNAL_INDEX_GRAPH_QUERY=

# 宽扫周期，单位秒。用于刷新账号池整体健康度。
LIQUIDATION_WIDE_SCAN_SECONDS=1800

# 近扫周期，单位秒。用于极低 HF 账号的高频观察。
LIQUIDATION_NEAR_SCAN_SECONDS=0.2

# 控制面板观察阈值。低于该 HF 的账号进入 watched_rows。
LIQUIDATION_WATCH_HEALTH_FACTOR=1.5

# 警告阈值。HF 低于该值但未低于触发阈值时标记 warning。
LIQUIDATION_WARNING_HEALTH_FACTOR=1.05

# 清算触发阈值。HF 低于该值时标记 liquidatable。
LIQUIDATION_TRIGGER_HEALTH_FACTOR=1.0

# 每轮最多扫描多少个账号。
LIQUIDATION_MAX_CANDIDATES=5000

# 健康度扫描并行 RPC worker 数量。
LIQUIDATION_SCAN_PARALLEL_WORKERS=8

# 账户批次规划大小；接入 Multicall3 时每批最多使用该数量。
LIQUIDATION_SCAN_BATCH_SIZE=100

# Avalanche C-Chain Multicall3；留空可禁用批量 getUserAccountData，自动回退单账户 RPC。
LIQUIDATION_MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# 无 Liquidation Data Provider 时的 close factor fallback。已有 provider 时优先使用真实 amountToPassToLiquidationCall。
LIQUIDATION_CLOSE_FACTOR=0.5

# 是否允许后台真实提交清算交易。可执行优先；仍需 HF、quote、staticCall、熔断保护全部通过。
LIQUIDATION_EXECUTION_ENABLED=true

# 自动执行引擎开关。true 为可执行优先：发现机会后通过预检则提交交易。
LIQUIDATION_AUTO_EXECUTE=true

# 手工清算测试已完成。设为 false 时，即使 LIQUIDATION_AUTO_EXECUTE=true 也会退回观察模式。
LIQUIDATION_MANUAL_TEST_COMPLETED=true

# 自动执行引擎轮询间隔，单位秒。受熔断 cooldown multiplier 影响时应由调用方放大。
LIQUIDATION_ENGINE_POLL_SECONDS=30

# Oracle/价格快照变化超过该 bps 时，优先扫描受影响资产相关账号。
LIQUIDATION_PRICE_TRIGGER_BPS=100
LIQUIDATION_PRICE_TRIGGER_BUFFER_BPS=25

# Oracle 事件检查间隔。默认 5 秒，用于价格更新后快速触发相关账户扫描。
LIQUIDATION_EVENT_POLL_SECONDS=5

# 自动执行引擎每轮最多处理账号数。
LIQUIDATION_ENGINE_MAX_ACCOUNTS=100

# 是否强制真实提交前必须 staticCall 通过。
LIQUIDATION_REQUIRE_STATIC_CALL=true

# 是否强制真实 flashloan 清算提交前必须 Hardhat fork transaction simulation 通过。
LIQUIDATION_REQUIRE_FORK_SIMULATION=true
LIQUIDATION_FORK_SIMULATION_TIMEOUT_SECONDS=180
LIQUIDATION_FORK_USE_CONFIGURED_EXECUTOR=true
LIQUIDATION_MIN_DEADLINE_REMAINING_SECONDS=60

# 单笔最大偿还 debtToCover，单位为 debt token 最小单位。0 表示不限制。
LIQUIDATION_MAX_DEBT_TO_COVER=0

# 最小利润阈值，单位为债务 token/base 最小单位。0 表示不限制。
LIQUIDATION_MIN_PROFIT_BASE=0

# 清算抵押物换回债务资产时的滑点保护，单位 bps。50 = 0.50%。
LIQUIDATION_SWAP_SLIPPAGE_BPS=50

# 调用 executor staticCall 时使用的 owner 地址。合约 requestLiquidation 有 onlyOwner。
LIQUIDATION_EXECUTOR_OWNER_ADDRESS=
# Used as the default CoW owner for quote/test flows too.
COW_REALTIME_QUOTE_ENABLED=true
COW_REALTIME_QUOTE_NETWORK=avalanche
COW_REALTIME_QUOTE_AMOUNT=1
COW_REALTIME_QUOTE_COOLDOWN_SECONDS=0.25
COW_REALTIME_QUOTE_MAX_INFLIGHT=2
COW_REALTIME_QUOTE_MAX_AGE_SECONDS=0.2
COW_FLASHLOAN_LIVE_MAX_AGE_SECONDS=0.2
# Real order submission is live only on Avalanche, BNB, Polygon, Base, and Ethereum for now.
COW_ORDER_SUBMISSION_ENABLED=false
COW_ORDER_SUBMISSION_ADAPTER_ENABLED=true
COW_ORDER_SUBMISSION_TIMEOUT_SECONDS=180
COW_ORDER_SIGNER_PRIVATE_KEY=
# Default execution-analysis mode: express one pure-profit intent first.
COW_FLASHLOAN_PURE_INTENT_ENABLED=true
# Minimum pure profit after all configured costs, as a percentage of starting capital.
COW_FLASHLOAN_PURE_INTENT_MIN_PROFIT_PERCENT=0.618
COW_FLASHLOAN_PURE_INTENT_GAS_RESERVE_USDC=0
COW_FLASHLOAN_PURE_INTENT_OTHER_KNOWN_COSTS_USDC=0
COW_FLASHLOAN_PURE_INTENT_CANDIDATE_LIMIT=3
# Live probe should quote both forward/reverse routes before selecting.
COW_FLASHLOAN_STOP_AFTER_FIRST_QUOTED_ROUTE=false
COW_FLASHLOAN_PROBE_MIN_PROFIT_USDC=0
COW_OWNER_ETHEREUM=
COW_OWNER_MAINNET=
COW_OWNER_GNOSIS=
COW_OWNER_XDAI=
COW_OWNER_ARBITRUM_ONE=
COW_OWNER_ARBITRUM=
COW_OWNER_BASE=
COW_OWNER_POLYGON=
COW_OWNER_AVALANCHE=
COW_OWNER_BNB=
COW_OWNER_BINANCE=
COW_OWNER_LINEA=
COW_OWNER_PLASMA=
COW_OWNER_INK=
COW_OWNER_SEPOLIA=

# Legacy optional contract optimization hooks. The current CoW intent flow uses
# the SDK directly and does not require deploying or configuring these.
# COW_FLASHLOAN_ROUTER_ADDRESS=
# COW_FLASHLOAN_BORROWER_ADDRESS=
# COW_FLASHLOAN_LENDER_ADDRESS=
# COW_FLASHLOAN_SETTLEMENT_CALLDATA=


# 复合套利实盘执行必须走原子闪电贷多步路线。
DEX_ROUTER_ADDRESS=
ATOMIC_FLASHLOAN_DEADLINE_SECONDS=60

# 执行清算交易时使用的私钥，必须对应上面的 owner 地址。
LIQUIDATION_EXECUTION_PRIVATE_KEY=

# 自有资金清算使用的私钥，用于直接 approve 债务代币并调用 Aave liquidationCall。
# 留空时回退使用 LIQUIDATION_EXECUTION_PRIVATE_KEY。
LIQUIDATION_SELF_FUNDED_PRIVATE_KEY=

# 自有资金清算多钱包并行提交，逗号分隔。配置 2-3 个钱包时用于降低被抢单概率。
# 未配置时使用 LIQUIDATION_SELF_FUNDED_PRIVATE_KEY 的单钱包路径。
LIQUIDATION_SELF_FUNDED_PRIVATE_KEYS=

# 清算账号池和扫描历史保留天数。
LIQUIDATION_RETENTION_DAYS=365

# 控制面板健康度刷新间隔，单位秒。
LIQUIDATION_SCAN_INTERVAL_SECONDS=300

# Borrow 发现扫描最小间隔，单位秒。
LIQUIDATION_DISCOVERY_INTERVAL_SECONDS=3600

# Avalanche 平均出块秒数估算。首次按时间回推区块时使用。
LIQUIDATION_BLOCK_SECONDS=2.0

# Borrow 扫描块号续扫时的重叠块数。1 表示重扫边界块，避免遗漏。
LIQUIDATION_DISCOVERY_BLOCK_OVERLAP=1

# 清算健康表最多显示多少个已扫描账号。watched_rows 仍按 HF 阈值单独保留。
LIQUIDATION_HEALTH_DISPLAY_LIMIT=200

# 是否启动后台自动清算发现/健康刷新线程。
LIQUIDATION_BACKGROUND_REFRESH=true

# 清算奖励估算百分比。用于没有更精确报价时的利润预估。
LIQUIDATION_BONUS_PERCENT=5.0

# Aave 闪电贷费率估算百分比。
LIQUIDATION_FLASHLOAN_FEE_PERCENT=0.05

# DEX 滑点/成本估算百分比。
LIQUIDATION_DEX_SLIPPAGE_PERCENT=0.10

# 单笔 gas 成本估算，单位 USD/base，用于净利润扣减。
LIQUIDATION_GAS_COST_USD=0

# 单笔最大允许 gas 成本，单位 USD/base。0 表示不限制。
LIQUIDATION_MAX_GAS_COST_USD=0

# MEV 和失败重试安全垫，单位 USD/base，会从 operator net profit 中扣减。
LIQUIDATION_MEV_BUFFER_USD=0
LIQUIDATION_RETRY_BUFFER_USD=0

# 扣除 gas、MEV、重试缓冲后的最小 operator 净利润，单位 USD/base。0 表示不限制。
LIQUIDATION_MIN_OPERATOR_NET_PROFIT_USD=1.0

# 是否允许使用 close factor fallback 和 flashloan premium fallback 进入提交。默认 false 更安全。
LIQUIDATION_ALLOW_FALLBACK_CLOSE_FACTOR=false
LIQUIDATION_ALLOW_FALLBACK_FLASHLOAN_PREMIUM=false

# 连续失败自动暂停。触发后需调用 pause-guard clear API 或删除 runtime/cache/liquidation_pause_guard.json。
LIQUIDATION_AUTO_PAUSE_ENABLED=true
LIQUIDATION_AUTO_PAUSE_FAILURE_THRESHOLD=3

# 是否要求同一个 DATABASE_URL 只有一个观察器写库，避免重复写入。
OBSERVER_REQUIRE_DB_LOCK=true

# 可选私有广播端点，优先尝试私有 RPC；格式为 name=url，逗号分隔。
# 为空时仅使用公共 RPC。LIQUIDATION_PRIVATE_RPC_URLS=

# 观察器 supervisor 心跳与崩溃自动重启退避，单位秒。
OBSERVER_SUPERVISOR_INTERVAL_SECONDS=5
OBSERVER_RESTART_BASE_DELAY_SECONDS=1
OBSERVER_RESTART_MAX_DELAY_SECONDS=30

# 纸面套利模拟名义本金，单位 USD。
ARBITRAGE_NOTIONAL_USD=1000

# 纸面套利交易手续费百分比。
ARBITRAGE_TRADE_FEE_PERCENT=0.10

# 纸面套利闪电贷费率百分比。
ARBITRAGE_FLASHLOAN_FEE_PERCENT=0.05

ARBITRAGE_TARGET_PROFIT_PERCENT=0.618

ARBITRAGE_ROUTE_TRADE_FEE_HOPS=3

# 触发纸面套利计算的最小窗口价差百分比。
ARBITRAGE_MIN_WINDOW_SPREAD_PERCENT=0.30

# 纸面套利最小利润，单位 USD。
ARBITRAGE_MIN_PAPER_PROFIT_USD=0

# 纸面套利额外费用/滑点安全垫百分比。
ARBITRAGE_FEE_RESERVE_PERCENT=0.10

# 纸面套利篮子大小，通常取 top N 和 bottom N 组合。
ARBITRAGE_BASKET_SIZE=5

# 可执行触发符号范围。AAVE_RESERVES 表示限制为缓存中的 Aave reserve。
TRIGGER_EXECUTABLE_SYMBOLS=AAVE_RESERVES

# 已支持生成执行路径的套利符号列表。
ARBITRAGE_EXECUTABLE_SYMBOLS=AVAXUSDT,ETHUSDT,BTCUSDT,AAVEUSDT

# 是否要求 Binance WebSocket 数据源在线才允许构造可执行套利计划。
ARBITRAGE_REQUIRE_BINANCE_WS=true

# UI 中固定展示的成本线，单位百分比。
FEE_SLIPPAGE_PERCENT=0.30

# DEX router 地址。默认是 Avalanche Trader Joe V2 router。
DEX_ROUTER_ADDRESS=0x60aE616a2155Ee3d9A68541Ba4544862310933d4

# 已部署的 AaveV3LiquidationExecutor 合约地址。未部署时留空，只能做扫描/估算。
LIQUIDATION_EXECUTOR_ADDRESS=

# DEX 成本探测使用的 USDC 名义金额列表，逗号分隔。
DEX_COST_USD_AMOUNTS=100,1000

# 普通执行计划报价滑点保护，单位 bps。50 = 0.50%。
EXECUTION_SLIPPAGE_BPS=50

# 可执行计划最大允许年龄，单位秒。超过后拒绝使用旧价格构造 payload。
EXECUTION_PLAN_MAX_AGE_SECONDS=15

# 短时间 smoke test 运行秒数。0 表示不自动停止。
RUN_SECONDS=0

# Flask 控制面板监听端口。Replit 通常会从环境变量注入 PORT。
PORT=5000
 
# Triangular A/B V3 execution.
# Use network-specific addresses only. Do not put Avalanche mainnet addresses into Fuji config.
TRIANGULAR_V3_FACTORY=
TRIANGULAR_V3_ROUTER=
TRIANGULAR_V3_QUOTER=
# Fee tiers for the two outer V3 hops. The X-Y fee is selected on-chain from the highPool.
TRIANGULAR_USDC_TO_TOKEN_X_FEE=3000
TRIANGULAR_TOKEN_Y_TO_USDC_FEE=3000
TRIANGULAR_MIN_PROFIT_USDC=1
TRIANGULAR_BORROW_AMOUNT_UNITS=100000000
TRIANGULAR_AMOUNT_OUT_MIN_USDC=100000000
# Contract B can auto-send each run's net profit to owner/deployer for test runs.
TRIANGULAR_PROFIT_SWEEP_ENABLED=true
TRIANGULAR_PROFIT_SWEEP_THRESHOLD_USDC=0
# Keep this much USDC in contract B after each run. 100 USDC = 100000000 for 6-decimal USDC.
TRIANGULAR_PROFIT_RESERVE_USDC=0
# Broadcast gas price cap. The script uses min(network gasPrice, this cap).
TRIANGULAR_MAX_GAS_PRICE_WEI=30000000000
# Runtime intent candidate strategy. expanded enables status1/status2/status5 expansion.
TRIANGULAR_DIRECT_CANDIDATE_STRATEGY=expanded
# Allow non-USDC tokenX to enter cross-pool C. Default false because cross-pool amount is tokenX-denominated.
TRIANGULAR_ENABLE_NON_USDC_CROSS_POOL=false
# Deployment safety floors used by preflight/deploy. Historical floor is based on Fuji CSV gas usage.
TRIANGULAR_MIN_DEPLOYER_BALANCE_AVAX=0.12
# Estimated setup tx budget and safety multiplier for A/B deployment gas checks.
TRIANGULAR_DEPLOY_CONFIG_GAS_UNITS=800000
TRIANGULAR_DEPLOY_GAS_SAFETY_BPS=15000
TRIANGULAR_DEPLOY_MIN_GAS_PRICE_WEI=25000000000
TRIANGULAR_DEPLOY_HISTORICAL_MIN_BUDGET_AVAX=0.25
