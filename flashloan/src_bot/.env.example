# Windows/local:
#   Copy this file to .env in this directory or a parent directory, then edit it.
#   Real .env files are ignored by git.

# Required. Postgres/Neon connection string.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. Avalanche C-Chain RPC endpoints.
# The app will try AVALANCHE_RPC first, then AVALANCHE_RPCS, then built-in fallbacks.
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_RPCS=https://api.avax.network/ext/bc/C/rpc,https://rpc.ankr.com/avalanche,https://avalanche-c-chain-rpc.publicnode.com
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1db02a252b5b4814aD
AAVE_PROTOCOL_DATA_PROVIDER_ADDRESS=
AAVE_LIQUIDATION_DATA_PROVIDER_ADDRESS=
FLASHLOAN_RUNTIME_DIR=runtime
AAVE_RESERVE_CACHE_FILE=runtime/cache/aave_reserve_assets.json
AAVE_RESERVE_CACHE_SECONDS=3600
AAVE_RESERVE_SYMBOL_LIMIT=1000

# Optional. Binance WebSocket bases. The observer rotates through this list.
# Public market streams do not require a Binance API key.
BINANCE_WS_BASES=wss://stream.binance.com:9443,wss://data-stream.binance.vision:443

# Optional. Binance REST fallback bases. Used when WebSocket is unavailable.
BINANCE_REST_BASES=https://api.binance.com,https://data-api.binance.vision
BINANCE_REST_POLL_SECONDS=3

# Optional network proxy.
# REST requests can use standard HTTP_PROXY/HTTPS_PROXY environment variables.
# The websockets package used here is best handled through an OS-level VPN/proxy
# or by relying on the data-stream Binance fallback above.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Optional. Supported symbols:
# AVAXUSDT, ETHUSDT, BTCUSDT, AAVEUSDT, USDCUSDT
SYMBOLS=AVAXUSDT,ETHUSDT,BTCUSDT,AAVEUSDT,USDCUSDT

# Optional sampling and reporting intervals.
SAMPLE_SECONDS=1
OBSERVATION_WRITE_SECONDS=1
AAVE_POLL_SECONDS=1
REPORT_SECONDS=2
STALE_SECONDS=30
ALERT_DIFF_PERCENT=0.30
REPORT_ONLY_ALERTS=false

# Optional Binance Top-N momentum monitor.
# Top symbols are resolved from market-cap data and mapped to Binance USDT pairs.
# BINANCE_SYMBOL_SELECTION:
#   market_cap: CoinGecko market-cap ranked USDT pairs.
#   movers: Binance 24h top gainers + top losers; not suitable for short-window velocity tests.
#   all_usdt: Binance USDT pairs sorted by symbol, capped by BINANCE_TOP_SYMBOL_LIMIT.
#   velocity: alias of all_usdt; use this for broad 200ms/1s gain-speed and drop-speed tests.
#   usdc_pools: Trader Joe USDC direct-pool tokens mapped to Binance USDT pairs.
#   stable_pools: union of direct-pool targets from configured stablecoins.
#   aave_borrow_pools: union of direct-pool targets from Aave borrowable reserves.
#   aave_binance_overlap: Aave assets intersected with Binance USDT spot listings.
BINANCE_SYMBOL_SELECTION=aave_binance_overlap
BINANCE_TOP_SYMBOL_LIMIT=0
BINANCE_VELOCITY_SIDE_LIMIT=100
BINANCE_WS_CHUNK_SIZE=200
BINANCE_MIN_QUOTE_VOLUME_USDT=0
BINANCE_CHANGE_WINDOW_SECONDS=1
BINANCE_VELOCITY_MIN_CHANGE_PERCENT=0.2
MARKET_DIVERGENCE_TRIGGER_MIN=1.0
TRIGGER_MIN_UP_CHANGE_PERCENT=1.0
TRIGGER_MIN_DOWN_CHANGE_PERCENT=1.0
# Database history write interval. The latest paper arbitrage result is still
# refreshed locally every SAMPLE_SECONDS.
BINANCE_EXTREME_WRITE_SECONDS=1
# Persist only the current top/bottom candidate set and candidate pair summaries.
# The UI now renders table rows for each route instead of curves.
BINANCE_CANDIDATE_DB_SIDE_LIMIT=10
BINANCE_PAIR_PRICE_WRITE_SECONDS=1
BINANCE_PAIR_PRICE_FLUSH_SECONDS=5
OBSERVATION_DB_WRITES=false
DEX_STABLE_TARGET_CACHE_FILE=runtime/cache/dex_stable_targets.json
DEX_STABLE_TARGET_CACHE_SECONDS=3600
DEX_TARGET_STABLE_TOKENS=USDC:0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E,USDT:0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7,USDC.e:0xA7D7079b0FEaD91F3e65f86E8915Cb59c1a4C664,USDT.e:0xc7198437980c041c805A1EDcbA50c1Ce5db95118,DAI.e:0xd586E7F844cEa2F87f50152665BCbc2C279D8d70
DEX_STABLE_POOL_FROM_BLOCK=0
DEX_STABLE_POOL_SCAN_CHUNK_SIZE=50000
DEX_BORROW_TARGET_CACHE_FILE=runtime/cache/dex_borrow_targets.json
DEX_BORROW_TARGET_CACHE_SECONDS=3600
DEX_BORROW_TARGET_SOURCE=dexscreener
DEX_BORROW_POOL_FROM_BLOCK=0
DEX_BORROW_POOL_SCAN_CHUNK_SIZE=50000

# Optional Aave liquidation scanner.
# Full-chain account discovery needs an indexer/subgraph or a database-backed address list.
# Wide scan refreshes warning candidates; near scan watches only critical candidates.
LIQUIDATION_AUTO_DISCOVER_ACCOUNTS=true
LIQUIDATION_RECENT_DISCOVERY_DAYS=7
LIQUIDATION_BACKFILL_WINDOW_DAYS=7
LIQUIDATION_BACKFILL_INTERVAL_SECONDS=3600
LIQUIDATION_BORROW_SCAN_CHUNK_SIZE=1000
LIQUIDATION_BORROW_DISCOVERY_LIMIT=5000
LIQUIDATION_WIDE_SCAN_SECONDS=1800
LIQUIDATION_NEAR_SCAN_SECONDS=0.2
LIQUIDATION_WATCH_HEALTH_FACTOR=1.5
LIQUIDATION_WARNING_HEALTH_FACTOR=1.05
LIQUIDATION_TRIGGER_HEALTH_FACTOR=1.0
LIQUIDATION_MAX_CANDIDATES=5000
LIQUIDATION_CLOSE_FACTOR=0.5
LIQUIDATION_RETENTION_DAYS=365
LIQUIDATION_SCAN_INTERVAL_SECONDS=300
LIQUIDATION_DISCOVERY_INTERVAL_SECONDS=3600
LIQUIDATION_BLOCK_SECONDS=2.0
LIQUIDATION_BACKGROUND_REFRESH=true
LIQUIDATION_BONUS_PERCENT=5.0
LIQUIDATION_FLASHLOAN_FEE_PERCENT=0.05
LIQUIDATION_DEX_SLIPPAGE_PERCENT=0.10
LIQUIDATION_GAS_COST_USD=0
# Keep one database writer per DATABASE_URL. This prevents multiple control
# panels/clients from writing duplicate market samples into the same database.
OBSERVER_REQUIRE_DB_LOCK=true

# Optional paper arbitrage simulation.
# Flow: borrow the biggest loser b, convert to biggest gainer a,
# sell a, buy b back, then compare with b repayment.
ARBITRAGE_NOTIONAL_USD=1000
ARBITRAGE_TRADE_FEE_PERCENT=0.10
ARBITRAGE_FLASHLOAN_FEE_PERCENT=0.05
ARBITRAGE_MIN_WINDOW_SPREAD_PERCENT=0.30
ARBITRAGE_MIN_PAPER_PROFIT_USD=0
ARBITRAGE_FEE_RESERVE_PERCENT=0.10
ARBITRAGE_BASKET_SIZE=5
# Only these symbols are used for executable paper plans. Keep this list aligned
# with Avalanche token/router support before attempting testnet or fork execution.
# Use AAVE_RESERVES to filter trigger candidates by cached Aave reserve assets.
TRIGGER_EXECUTABLE_SYMBOLS=AAVE_RESERVES
ARBITRAGE_EXECUTABLE_SYMBOLS=AVAXUSDT,ETHUSDT,BTCUSDT,AAVEUSDT
# Safety guard: executable arbitrage plans must be built from Binance WebSocket
# ticks. REST fallback is observation-only and must not drive live execution.
ARBITRAGE_REQUIRE_BINANCE_WS=true

# Optional. Fixed cost line shown on the diff chart: slippage + fees, in percent.
FEE_SLIPPAGE_PERCENT=0.30

# Optional. Dynamic DEX cost quote settings.
# Default router is Trader Joe V2 on Avalanche. Amounts are USDC trade sizes.
DEX_ROUTER_ADDRESS=0x60aE616a2155Ee3d9A68541Ba4544862310933d4
LIQUIDATION_EXECUTOR_ADDRESS=
DEX_COST_USD_AMOUNTS=100,1000
# Slippage guard for execution plan quotes. 50 bps = 0.50%.
EXECUTION_SLIPPAGE_BPS=50
# Refuse to quote stale plans for execution. This prevents using an old plan
# after WebSocket data stops.
EXECUTION_PLAN_MAX_AGE_SECONDS=15

# Optional. Set to a positive value for short smoke tests.
RUN_SECONDS=0

# Optional Flask port for run.py/control_panel.py.
PORT=5000
