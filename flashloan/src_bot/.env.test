# Testnet-only contract/runtime addresses.
# Private keys and account secrets stay in .env. Do not put keys in this file.

TRIANGULAR_TESTNET_NAME=fuji
TRIANGULAR_TESTNET_CHAIN_ID=43113
FUJI_RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com
AVALANCHE_FUJI_RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com

# Fill these after redeploying the updated V3 A/B contracts on Fuji.
TRIANGULAR_ROUTE_CONTROLLER_ADDRESS=0x...
AAVE_TRIANGULAR_EXECUTOR_ADDRESS=0x...

# Fuji Aave V3 addresses from @aave-dao/aave-address-book 4.65.5.
TRIANGULAR_AAVE_POOL_ADDRESS=0x8B9b2AF4afB389b4a70A474dfD4AdCD4a302bb40
TRIANGULAR_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# V3 execution adapter. Must be real Fuji V3-compatible contracts.
TRIANGULAR_V3_FACTORY=0x...
TRIANGULAR_V3_ROUTER=0x...
TRIANGULAR_V3_QUOTER=0x...

# Read-only Fuji DEX capability probe. These addresses are not accepted by the
# V3-only executor and are kept solely to explain current testnet coverage.
FUJI_V2_ROUTER_ADDRESS=0xd7f655E3376cE2D7A2b08fF01Eb3B1023191A901
FUJI_V2_FACTORY_ADDRESS=0xF5c7d9733e5f53abCC1695820c4818C59B457C2C

# V3 fee tiers for outer hops. A selects the X-Y fee from the chosen highPool.
TRIANGULAR_USDC_TO_TOKEN_X_FEE=3000
TRIANGULAR_TOKEN_Y_TO_USDC_FEE=3000

# B profit sweep for test runs: send each profitable run's net profit to the deployer/owner.
TRIANGULAR_PROFIT_SWEEP_ENABLED=true
TRIANGULAR_PROFIT_SWEEP_THRESHOLD_USDC=0
# Keep this much USDC in contract B after each run. 0 means sweep all post-repayment USDC.
TRIANGULAR_PROFIT_RESERVE_USDC=0

# Small test execution defaults. Keep broadcast disabled until preflight and staticCall pass.
TRIANGULAR_DIRECT_EXECUTION_MODE=auto
TRIANGULAR_BORROW_AMOUNT_UNITS=100000000
TRIANGULAR_EXECUTION_AMOUNT_USDC_BASE_UNITS=100000000
TRIANGULAR_AMOUNT_OUT_MIN_USDC=100000000
TRIANGULAR_MIN_PROFIT_USDC_BASE_UNITS=1000000
TRIANGULAR_MIN_PROFIT_USDC=1000000
# Broadcast safety floor. This must include the operator's worst-case gas,
# relay and retry budget in USDC base units; 1000000 equals 1 USDC.
TRIANGULAR_MIN_NET_PROFIT_USDC_BASE_UNITS=1000000
TRIANGULAR_CROSS_POOL_BORROW_AMOUNT_UNITS=100000000
TRIANGULAR_CROSS_POOL_MIN_FINAL_TOKEN_X=100000000
TRIANGULAR_CROSS_POOL_MIN_PROFIT_TOKEN_X_BASE_UNITS=1
TRIANGULAR_RUNTIME_TRADES_JSON=
TRIANGULAR_AB_BROADCAST_ENABLED=false
TRIANGULAR_DIRECT_BROADCAST_ENABLED=false
TRIANGULAR_MAX_GAS_PRICE_WEI=30000000000
# Deployment safety floors used by preflight/deploy. Historical floor is based on Fuji CSV gas usage.
TRIANGULAR_MIN_DEPLOYER_BALANCE_AVAX=0.12
TRIANGULAR_DEPLOY_CONFIG_GAS_UNITS=800000
TRIANGULAR_DEPLOY_GAS_SAFETY_BPS=15000
TRIANGULAR_DEPLOY_MIN_GAS_PRICE_WEI=25000000000
TRIANGULAR_DEPLOY_HISTORICAL_MIN_BUDGET_AVAX=0.25

# Last legacy mock fixture, for audit only. Do not execute against these after the V3/sweep update.
LEGACY_FUJI_MOCK_CONTROLLER_ADDRESS=0x3cd11f3b8d1a438ed6f674759e71a50eb7ff15b8
LEGACY_FUJI_MOCK_EXECUTOR_ADDRESS=0x419d9aa09c4d9c220fb33620bace71f5cf5142fc
LEGACY_FUJI_MOCK_USDC_ADDRESS=0xebe15d4b6ae0750d52a78ac1586f71c162662309
LEGACY_FUJI_MOCK_AAVE_POOL_ADDRESS=0x6f02166952de3eec32b3767b75d91921bfb5feda
LEGACY_FUJI_MOCK_ROUTER_ADDRESS=0x72025e24941cbeea253b3b9135eb9ffa31d21725
