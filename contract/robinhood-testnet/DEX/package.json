{
  "name": "flashloan-testnet-executor",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:robinhood": "hardhat test test/RobinhoodPausedFlashLoanExecutor.test.js test/RobinhoodTestnetReadiness.test.js",
    "test:robinhood:offchain-normal": "hardhat test test/RobinhoodV4FlashNormalProbe.test.js",
    "ready:robinhood:offchain-normal": "hardhat run scripts/check-robinhood-v4-flash-offchain-normal.js --network hardhat",
    "ready:robinhood:executor-offchain-normal": "hardhat run scripts/check-robinhood-executor-v4-flash-offchain-normal.js --network hardhat",
    "stage:robinhood:testnet:predeploy": "hardhat run scripts/check-robinhood-stage-freeze.js --network robinhoodTestnet",
    "preflight:robinhood:testnet": "hardhat run scripts/preflight-robinhood-testnet.js --network robinhoodTestnet",
    "ready:robinhood:testnet": "hardhat run scripts/check-robinhood-testnet-readiness.js --network robinhoodTestnet",
    "ready:robinhood:testnet:live": "python ../../../flashloan/src/dex/tools/check_robinhood_live_testing_readiness.py",
    "plan:robinhood:testnet:paused-redeploy": "hardhat run scripts/plan-robinhood-paused-redeploy.js --network robinhoodTestnet",
    "readback:robinhood:testnet": "hardhat run scripts/readback-robinhood-paused-executor.js --network robinhoodTestnet",
    "preflight:robinhood:testnet:dynamic-v4-route": "hardhat run scripts/preflight-robinhood-dynamic-v4-route.js --network robinhoodTestnet",
    "deploy:robinhood:testnet:v4flash:normal-probe": "hardhat run scripts/deploy-robinhood-v4-flash-normal-probe.js --network robinhoodTestnet",
    "probe:robinhood:testnet:v4flash:normal": "hardhat run scripts/probe-robinhood-v4-flash-normal.js --network robinhoodTestnet",
    "probe:robinhood:testnet:v4flash:normal:live": "set ROBINHOOD_TESTNET_ALLOW_NORMAL_FLASH_BROADCAST=true&& hardhat run scripts/probe-robinhood-v4-flash-normal.js --network robinhoodTestnet",
    "deploy:robinhood:testnet:paused": "hardhat run scripts/deploy-robinhood-paused-executor.js --network robinhoodTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "hardhat": "^2.26.1"
  },
  "dependencies": {
    "@cowprotocol/sdk-config": "^2.4.0",
    "@cowprotocol/sdk-flash-loans": "^3.3.3",
    "@cowprotocol/sdk-trading": "^2.2.6",
    "@cowprotocol/sdk-viem-adapter": "^0.3.26",
    "dotenv": "^17.2.1",
    "viem": "^2.55.11"
  }
}
