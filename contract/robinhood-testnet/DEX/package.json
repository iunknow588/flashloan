    "test:robinhood:offchain-normal": "hardhat test test/RobinhoodV4FlashNormalProbe.test.js",
    "test:robinhood:v4-amm-arb": "hardhat test test/v4_flash_amm_arb/RobinhoodV4FlashImbalancedArb.test.js",
    "test:robinhood:tz-injection-hook": "hardhat test test/tz_injection_hook/TzTieredInjectionHook.test.js",
    "simulate:robinhood:imbalanced": "hardhat run ../../../test-token_create/scripts/simulate-imbalanced-triangle.js --network hardhat",
    "simulate:robinhood:v4-amm-arb": "hardhat run ../../../test-token_create/scripts/local-v4-amm-run-arb.js --network localhost",
    "local:v4-amm:create-tokens": "hardhat run ../../../test-token_create/scripts/local-v4-amm-create-tokens.js --network localhost",
    "local:v4-amm:inject-liquidity": "hardhat run ../../../test-token_create/scripts/local-v4-amm-inject-liquidity.js --network localhost",
    "local:v4-amm:create-arb-opportunity": "hardhat run ../../../test-token_create/scripts/local-v4-amm-create-arb-opportunity.js --network localhost",
    "local:v4-amm:run-arb": "hardhat run ../../../test-token_create/scripts/local-v4-amm-run-arb.js --network localhost",
    "local:v4-amm:run-arb-100": "hardhat run ../../../test-token_create/scripts/local-v4-amm-run-arb-100.js --network localhost",
    "deploy:robinhood:testnet:v4-amm-live": "set ROBINHOOD_TESTNET_ALLOW_V4_AMM_LIVE_TEST=true&& hardhat run ../../../test-token_create/scripts/testnet-v4-amm-live-test.js --network robinhoodTestnet",
    "deploy:robinhood:testnet:v4-official-pool": "set ROBINHOOD_TESTNET_ALLOW_V4_AMM_LIVE_TEST=true&& hardhat run ../../../test-token_create/scripts/testnet-v4-official-pool-create-live.js --network robinhoodTestnet",
    "testnet:v4-official-arb:preflight": "hardhat run ../../../test-token_create/scripts/testnet-v4-official-arb-live.js --network robinhoodTestnet",
    "testnet:v4-official-arb:live": "set ROBINHOOD_TESTNET_ALLOW_V4_AMM_LIVE_TEST=true&& set ROBINHOOD_TESTNET_ALLOW_OFFICIAL_V4_ARB_BROADCAST=true&& hardhat run ../../../test-token_create/scripts/testnet-v4-official-arb-live.js --network robinhoodTestnet",
    "testnet:v4-official-replenish:preflight": "hardhat run ../../../test-token_create/scripts/testnet-v4-official-inject-liquidity-live.js --network robinhoodTestnet",
    "testnet:v4-official-replenish:live": "set ROBINHOOD_TESTNET_ALLOW_V4_AMM_LIVE_TEST=true&& set ROBINHOOD_TESTNET_ALLOW_OFFICIAL_V4_REPLENISH_BROADCAST=true&& hardhat run ../../../test-token_create/scripts/testnet-v4-official-inject-liquidity-live.js --network robinhoodTestnet",
    "testnet:v4-official-make-arb:preflight": "hardhat run ../../../test-token_create/scripts/testnet-v4-official-make-arb-opportunity-live.js --network robinhoodTestnet",
    "testnet:v4-official-make-arb:live": "set ROBINHOOD_TESTNET_ALLOW_V4_AMM_LIVE_TEST=true&& set ROBINHOOD_TESTNET_ALLOW_OFFICIAL_V4_MAKE_ARB_BROADCAST=true&& hardhat run ../../../test-token_create/scripts/testnet-v4-official-make-arb-opportunity-live.js --network robinhoodTestnet",
    "ready:robinhood:offchain-normal": "hardhat run scripts/check-robinhood-v4-flash-offchain-normal.js --network hardhat",
    "ready:robinhood:executor-offchain-normal": "hardhat run scripts/check-robinhood-executor-v4-flash-offchain-normal.js --network hardhat",
    "stage:robinhood:testnet:predeploy": "hardhat run scripts/check-robinhood-stage-freeze.js --network robinhoodTestnet",
    "preflight:robinhood:testnet": "hardhat run scripts/preflight-robinhood-testnet.js --network robinhoodTestnet",
    "ready:robinhood:testnet": "hardhat run scripts/check-robinhood-testnet-readiness.js --network robinhoodTestnet",
    "ready:robinhood:testnet:live": "python ../../../flashloan/src/dex/tools/check_robinhood_live_testing_readiness.py",
    "plan:robinhood:testnet:paused-redeploy": "hardhat run scripts/plan-robinhood-paused-redeploy.js --network robinhoodTestnet",
    "readback:robinhood:testnet": "hardhat run scripts/readback-robinhood-paused-executor.js --network robinhoodTestnet",
    "preflight:robinhood:testnet:dynamic-v4-route": "hardhat run scripts/preflight-robinhood-dynamic-v4-route.js --network robinhoodTestnet",
    "deploy:robinhood:testnet:v4flash:normal-probe": "hardhat run scripts/deploy-robinhood-v4-flash-normal-probe.js --network robinhoodTestnet",
    "probe:robinhood:testnet:v4flash:normal": "hardhat run scripts/probe-robinhood-v4-flash-normal.js --network robinhoodTestnet",
    "probe:robinhood:testnet:v4flash:normal:live": "set ROBINHOOD_TESTNET_ALLOW_NORMAL_FLASH_BROADCAST=true&& hardhat run scripts/probe-robinhood-v4-flash-normal.js --network robinhoodTestnet",
    "deploy:robinhood:testnet:paused": "hardhat run scripts/deploy-robinhood-paused-executor.js --network robinhoodTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "hardhat": "^2.26.1"
  },
  "dependencies": {
    "@cowprotocol/sdk-config": "^2.4.0",
    "@cowprotocol/sdk-flash-loans": "^3.3.3",
    "@cowprotocol/sdk-trading": "^2.2.6",
    "@cowprotocol/sdk-viem-adapter": "^0.3.26",
    "dotenv": "^17.2.1",
    "viem": "^2.55.11"
  }
}
