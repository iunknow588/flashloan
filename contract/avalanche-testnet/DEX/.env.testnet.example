# Dedicated Avalanche Fuji RPC.
FUJI_RPC_URL=https://your-dedicated-fuji-rpc.example

# Deployer key. Never commit a real .env file.
DEPLOYER_PRIVATE_KEY=0xyour_private_key

# Broadcast stays disabled until the unified preview and static call both succeed.
UNIFIED_EXECUTOR_BROADCAST_ENABLED=false

# Leave FUJI_RUN_ID empty to generate a timestamped run ID.
FUJI_RUN_ID=
FUJI_EVIDENCE_DIR=deployments/evidence
TESTNET_TRADE_LOG=deployments/fuji-trades.jsonl

# Aave V3 Pool and the exact USDC asset enabled in that pool.
UNIFIED_AAVE_POOL_ADDRESS=0x...
UNIFIED_USDC_ADDRESS=0x...

# Fill after deploy:unified:fuji.
UNIFIED_EXECUTOR_ADDRESS=0x...

# Runtime adapter whitelist. Production should pin the real V3 factory.
UNIFIED_V3_FACTORY=0x...
UNIFIED_V3_ROUTER=0x...
UNIFIED_V3_QUOTER=0x...

# First-layer runtime risk filters used by A while scanning calldata pools.
UNIFIED_MIN_POOL_LIQUIDITY=1
UNIFIED_MIN_TICK_DELTA=1

# Bot-side candidate strategy and cross-pool safety gate.
TRIANGULAR_DIRECT_CANDIDATE_STRATEGY=expanded
# 0 scans every cache-discovered USDC route group; a positive value caps one cycle.
TRIANGULAR_RUNTIME_ROUTE_GROUP_LIMIT=25
TRIANGULAR_ENABLE_NON_USDC_CROSS_POOL=false

# All trade pairs and pools are calldata inputs. The unified executor does not
# store a pair table or pool table. Each trade has exactly five pool slots.
# The bot must submit one coherent ordered group:
# trade[0] = U-X, trade[1] = U-Y, trade[2] = X-Y, trade[3] = Y-X fallback.
TRIANGULAR_RUNTIME_TRADES_JSON=[
  {
    "tradeIndex": 0,
    "tokenX": "0x...",
    "tokenY": "0x...",
    "pools": [
      {"adapterKind": 1, "pool": "0x..."},
      {"adapterKind": 1, "pool": "0x..."}
    ]
  }
]
