# Robinhood mainnet paused deployment rehearsal template.
# Static chain metadata lives in chain.json.
# Global account/private-key values stay in flashloan/app_runtime/.env.
# Do not commit real RPC URLs or private keys.

# Mainnet V4 addresses are placeholders until verified on chain 4663.
# Leave them empty unless chain 4663 evidence verifies code.
ROBINHOOD_MAINNET_V4_POOL_MANAGER=
ROBINHOOD_MAINNET_V4_QUOTER=
ROBINHOOD_MAINNET_V4_UNIVERSAL_ROUTER=
ROBINHOOD_MAINNET_PERMIT2=

# Optional unless the frozen route contains V3 hops.
ROBINHOOD_MAINNET_REQUIRE_V3=true
ROBINHOOD_MAINNET_V3_SWAP_ROUTER=

# Mainnet flash source kind for the Robinhood executor must stay 4 (Uniswap V4
# PoolManager flash accounting) for the V4 contract path.
ROBINHOOD_MAINNET_FLASH_SOURCE_KIND=4

# Deployment and broadcast gates are closed by default. Keep them false.
ROBINHOOD_MAINNET_ALLOW_PAUSED_DEPLOY=false
ROBINHOOD_MAINNET_PREFLIGHT_STRICT=1
