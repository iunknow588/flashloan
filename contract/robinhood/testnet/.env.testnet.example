# Robinhood testnet paused deployment rehearsal.
# Copy values into the runtime env file that your shell loads; do not commit real RPC URLs or private keys.

# Official public RPC from Robinhood Chain docs.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
DEPLOYER_PRIVATE_KEY=

# Required before `npm run ready:robinhood:testnet` can pass.
ROBINHOOD_TESTNET_FLASH_SOURCE=0x8366a39CC670B4001A1121B8F6A443A643e40951
ROBINHOOD_TESTNET_FLASH_SOURCE_KIND=4
ROBINHOOD_TESTNET_V4_UNIVERSAL_ROUTER=0x8876789976DecbFCbBbe364623C63652db8c0904
ROBINHOOD_TESTNET_V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
ROBINHOOD_TESTNET_POSITION_MANAGER=0x58DaEC3116AAe6D93017BaaEA7749052E8a04fa7
ROBINHOOD_TESTNET_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
ROBINHOOD_TESTNET_WETH_ADDRESS=0x7943e237c7F95DA44E0301572D358911207852Fa
ROBINHOOD_TESTNET_MULTICALL3=0xa432504b6F04Cafe775b09D8AA92e8dbe41Ec7a8

# Leave lending-pool addresses empty unless chain 46630 evidence verifies code
# and non-zero borrow-token liquidity. Mainnet Robinhood addresses must not be reused here.
ROBINHOOD_TESTNET_AAVE_POOL=
ROBINHOOD_TESTNET_AAVE_V3_POOL=
ROBINHOOD_TESTNET_MORPHO_BLUE=
ROBINHOOD_TESTNET_BORROW_TOKEN_ADDRESSES=

# Optional unless the frozen route contains V3 hops.
ROBINHOOD_TESTNET_REQUIRE_V3=false
ROBINHOOD_TESTNET_V3_SWAP_ROUTER=
ROBINHOOD_TESTNET_V3_FACTORY=
ROBINHOOD_TESTNET_V3_QUOTER=

# Testnet token conservation. Keep abnormal on-chain tests disabled until
# normal flash-accounting tests have earned enough test tokens for revert cases.
ROBINHOOD_TESTNET_ONCHAIN_TEST_MODE=normal_only
ROBINHOOD_TESTNET_ENABLE_ABNORMAL_ONCHAIN_TESTS=false
ROBINHOOD_TESTNET_V4_FLASH_PROBE=
ROBINHOOD_TESTNET_NORMAL_FLASH_TOKEN=
ROBINHOOD_TESTNET_NORMAL_FLASH_AMOUNT=0
ROBINHOOD_TESTNET_MAX_NORMAL_FLASH_AMOUNT=0
ROBINHOOD_TESTNET_MIN_PROFIT_TOKEN_RESERVE=0
ROBINHOOD_TESTNET_ALLOW_NORMAL_FLASH_BROADCAST=false

# Repayment guard defaults are zero for paused rehearsal unless explicitly set.
ROBINHOOD_TESTNET_FLASH_SOURCE_FEE_BPS=0
ROBINHOOD_TESTNET_MAX_FLASH_FEE_BPS=0
ROBINHOOD_TESTNET_REPAYMENT_MIN_PROFIT=0
ROBINHOOD_TESTNET_REPAYMENT_GAS_RESERVE=0
ROBINHOOD_TESTNET_MIN_DEPLOYER_BALANCE_WEI=1
ROBINHOOD_TESTNET_PAUSED_DEPLOY_GAS_SAFETY_BPS=15000
ROBINHOOD_TESTNET_PAUSED_DEPLOY_CONFIG_GAS_UNITS=700000
ROBINHOOD_TESTNET_EXECUTOR_DEPLOYMENT_FILE=
ROBINHOOD_TESTNET_EXECUTOR_ADDRESS=

# Keep production broadcast closed.
ROBINHOOD_TESTNET_PREFLIGHT_STRICT=1
ROBINHOOD_TESTNET_EXECUTOR_OFFCHAIN_NORMAL_FLASH_AMOUNT=1000

# Paused executor deployment still broadcasts a testnet transaction.
# Keep false until readiness passes and you intentionally want to spend testnet ETH.
ROBINHOOD_TESTNET_ALLOW_PAUSED_DEPLOY=false

# Set only after the local executor code reaches a stage-frozen milestone.
# Required value for paused redeploy:
# ROBINHOOD_TESTNET_DEPLOY_MILESTONE=paused_executor_v4_accounting_freeze
ROBINHOOD_TESTNET_DEPLOY_MILESTONE=
