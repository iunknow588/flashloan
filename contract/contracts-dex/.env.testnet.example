# Dedicated Avalanche Fuji RPC.
FUJI_RPC_URL=https://your-dedicated-fuji-rpc.example

# Deployer key. Never commit a real .env file.
DEPLOYER_PRIVATE_KEY=0xyour_private_key

# Keep false until previewBestRoute and run.staticCall both succeed.
FUJI_EXECUTION_ENABLED=false
TRIANGULAR_AB_BROADCAST_ENABLED=false

# Leave FUJI_RUN_ID empty to generate a timestamped run ID.
FUJI_RUN_ID=
FUJI_EVIDENCE_DIR=deployments/evidence
TESTNET_TRADE_LOG=deployments/fuji-trades.jsonl

# Aave V3 Pool and the exact USDC asset enabled in that pool.
TRIANGULAR_AAVE_POOL_ADDRESS=0x...
TRIANGULAR_USDC_ADDRESS=0x...

# Fill after deploy:fuji-triangular-ab.
TRIANGULAR_ROUTE_CONTROLLER_ADDRESS=0x...
TRIANGULAR_AAVE_EXECUTOR_ADDRESS=0x...

# The router must implement both Uniswap V2-style methods:
# getAmountsOut(uint256,address[]) and
# swapExactTokensForTokens(uint256,uint256,address[],address,uint256).
TRIANGULAR_DEX_ROUTER=0x...
TRIANGULAR_TOKEN_X=0x...
TRIANGULAR_TOKEN_Y=0x...

# Raw USDC units. For a 6-decimal USDC, 1 USDC is 1000000.
TRIANGULAR_BORROW_AMOUNT_UNITS=1000000
TRIANGULAR_AAVE_PREMIUM_BPS=5
TRIANGULAR_MIN_PROFIT_USDC_UNITS=1
TRIANGULAR_SLIPPAGE_BPS=50
TRIANGULAR_DEADLINE_SECONDS=60
