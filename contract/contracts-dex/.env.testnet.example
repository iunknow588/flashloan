# Dedicated Avalanche Fuji RPC.
FUJI_RPC_URL=https://your-dedicated-fuji-rpc.example

# Deployer key. Never commit a real .env file.
DEPLOYER_PRIVATE_KEY=0xyour_private_key

# Broadcast stays disabled until previewBestRuntimeTrades and
# runBestRuntimeTrades.staticCall both succeed.
TRIANGULAR_AB_BROADCAST_ENABLED=false

# Leave FUJI_RUN_ID empty to generate a timestamped run ID.
FUJI_RUN_ID=
FUJI_EVIDENCE_DIR=deployments/evidence
TESTNET_TRADE_LOG=deployments/fuji-trades.jsonl

# Aave V3 Pool and the exact USDC asset enabled in that pool.
# B still binds these addresses, even while A only performs runtime selection.
TRIANGULAR_AAVE_POOL_ADDRESS=0x...
TRIANGULAR_USDC_ADDRESS=0x...

# Fill after deploy:fuji-triangular-ab.
TRIANGULAR_ROUTE_CONTROLLER_ADDRESS=0x...
AAVE_TRIANGULAR_EXECUTOR_ADDRESS=0x...

# Runtime-only adapter whitelist for A. factory may be zero for mock-only
# checks, but production should pin the real V3 factory.
TRIANGULAR_V3_FACTORY=0x...
TRIANGULAR_V3_ROUTER=0x...
TRIANGULAR_V3_QUOTER=0x...

# First-layer runtime risk filters used by A while scanning calldata pools.
TRIANGULAR_MIN_POOL_LIQUIDITY=1
TRIANGULAR_MIN_TICK_DELTA=1

# All trade pairs and pools are calldata inputs. A does not store a pair table
# or pool table. pools may contain 1 to 10 entries; scripts pad empty slots.
TRIANGULAR_RUNTIME_TRADES_JSON=[
  {
    "tradeIndex": 0,
    "tokenX": "0x...",
    "tokenY": "0x...",
    "pools": [
      {"adapterKind": 1, "pool": "0x..."},
      {"adapterKind": 1, "pool": "0x..."}
    ]
  }
]
