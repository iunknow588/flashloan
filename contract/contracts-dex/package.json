{
  "name": "flashloan-testnet-executor",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test",
    "test:payload": "python -m pytest ../flashloan/srcs_dex/tests/test_execution_payload.py ../flashloan/srcs_dex/tests/test_plan_quotes.py",
    "test:quotes": "python -m pytest ../flashloan/srcs_dex/tests/test_plan_quotes.py",
    "test:strategy": "python -m pytest ../flashloan/srcs_dex/tests/test_arbitrage_strategy.py",
    "preflight:fuji": "hardhat run scripts/preflight-fuji.js --network fuji",
    "deploy:fuji-fixture": "hardhat run scripts/deploy-fuji-test-fixture.js --network fuji",
    "deploy:fuji": "hardhat run scripts/deploy-mock-funded-executor.js --network fuji",
    "deploy:fuji-aave": "hardhat run scripts/deploy-aave-executor.js --network fuji",
    "deploy:fuji-dynamic": "hardhat run scripts/deploy-dynamic-aave-executor.js --network fuji",
    "execute:fuji": "hardhat run scripts/execute-fuji-roundtrip.js --network fuji",
    "execute:fuji-payload": "hardhat run scripts/execute-payload-mock-funded.js --network fuji",
    "execute:fuji-aave-payload": "hardhat run scripts/execute-aave-payload.js --network fuji",
    "execute:fuji-dynamic-signal": "hardhat run scripts/execute-dynamic-signal.js --network fuji",
    "simulate:fuji-dynamic-signal": "hardhat run scripts/simulate-dynamic-signal.js --network fuji",
    "probe:cow-flashloans": "node scripts/probe-cow-flashloans.js",
    "verify:fuji-guards": "hardhat run scripts/verify-fuji-guards.js --network fuji"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "dotenv": "^17.2.1",
    "hardhat": "^2.26.1"
  },
  "dependencies": {
    "@cowprotocol/sdk-config": "^2.4.0",
    "@cowprotocol/sdk-flash-loans": "^3.3.3",
    "@cowprotocol/sdk-trading": "^2.2.6",
    "@cowprotocol/sdk-viem-adapter": "^0.3.26",
    "viem": "^2.55.11"
  }
}
