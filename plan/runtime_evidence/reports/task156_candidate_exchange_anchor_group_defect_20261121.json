{
  "schema": "task156-candidate-exchange-anchor-group-defect-v1",
  "generatedAt": "2026-11-21T05:59:52.961676+00:00",
  "task": "TASK-156",
  "title": "candidate_exchange 观测层把锚点排除在自己的 token 组之外，导致锚点自身的边池不可达",
  "authority": "shipped-artifact",
  "confidence": "observed",
  "environment": {
    "platform": "windows",
    "architecture": "x86_64",
    "isolation": "none",
    "id": "workstation"
  },
  "component": {
    "crate": "candidate-exchange-pool-manager",
    "file": "flashloan/tools/candidate_exchange_pool_manager/src/lib.rs",
    "functions": [
      "read_anchor_groups",
      "read_anchor_symbols",
      "validate_candidate_edge_state"
    ],
    "referenceImplementation": "flashloan/tools/closed_loop_manager/src/lib.rs::read_anchors"
  },
  "rootCause": {
    "table": "manager_dex_candidate_anchor_tokens",
    "rowSemantics": "每行是一个 *(anchor_token_key_id, token_key_id)* 的候选边：锚点是资金币，token_key_id 是与之成交的对手币。生产数据**没有**自引用行（anchor_token_key_id = token_key_id 的行数为 0）。",
    "defect": "candidate_exchange 的 read_anchor_groups 只把 token_key_id（对手币）放进锚点组，**从不把锚点自己放进去**。随后 build_exchange_rows 要求池的两个端点都在该组内 ('tokens.contains(token0) && tokens.contains(token1)')，于是锚点自身的边池（端点 = {锚点, 对手币}）因锚点不在组内而被丢弃。",
    "consequence": "所有依赖锚点自身边池的方向都变成 no_reachable_v4_pool；观测方向数 4（且全空）→ 20（16 有池）；闭环无法形成。",
    "whyItWentUnnoticed": "单元测试夹具 seed_candidate_edge_state 写入了一条自引用行 (ANCHOR, ANCHOR)，掩盖了生产形态。",
    "secondaryDefect": "read_anchor_symbols 用 'AND anchor_token_key_id = token_key_id' 取锚点符号，生产数据下该集合恒为空，比较路径会以 'missing display symbol for anchor' 失败。",
    "validatorCorrection": "validate_candidate_edge_state 原先把「组成员并集」与 candidate_edge 状态里的 candidate_token_count（= 行的去重对手币数）相比；修复后锚点进入组内，两者语义不同，改为直接按行统计的去重对手币数比对。"
  },
