  "authority": "read-only measurement of what the background download actually is; nothing written, nothing disabled",
  "theQuestion": "what is the 1296.82 GiB, and can it be optimised",
  "answer": {
    "headline": "the 1296.82 GiB is NOT 1296 GiB of files on disk, and NOT 1296 GiB of unique content. It is an installer's CUMULATIVE download counter that adds up every byte it re-downloads on every run.",
    "actualBytesOnDisk": {
      "globalPackageCache": {
        "path": "C:\\ProgramData\\Microsoft\\VisualStudio\\Packages",
        "files": 2620,
        "bytes": 10672912975,
        "gib": 9.94
      },
      "userScopePackages": {
        "path": "C:\\Users\\iunkn\\AppData\\Local\\Microsoft\\VisualStudio\\Packages\\_Instances",
        "files": 3,
        "bytes": 1634,
        "gib": 0.0
      },
      "totalOnDiskGiB": 9.94,
      "counterToDiskRatio": 130.5
    },
    "whyTheCounterIsSoLarge": [
      "every background run re-downloads the SAME package set (proven below), and the installer ADDS each run's bytes to updateDownloadedSize instead of replacing it",
      "238f66ce (VS 2019 16.11, EOL): downloaded=1,314,698,544,469 B but updateDownloadTotalSize=368,117,857 B -> the counter is 3571x the total size of the update",
      "968a13cd (VS 2022 17.14): downloaded=77,747,396,829 B vs total=4,834,721,559 B -> 16.1x",
      "the counters stopped growing only because the sandbox watchdog kills the download process, not because the download stopped being scheduled"
    ],
    "whatIsActuallyDownloaded": {
      "distinctPackagesPerRun": 482,
      "runsCompared": 2,
      "allRunsDownloadedIdenticalPackageSet": true,
      "packageCategories": {
        "(core/other)": 400,
        "Android": 17,
        "MAUI": 14,
        "Mono": 13,
        "Unity": 12,
        "Linux": 9,
        "iOS": 8,
        "Unreal": 6,
        "MDD": 2,
        "Emulator": 1
      },
      "whyTheseCategories": "includeRecommended=1 on the 17.14 instance pulls the RECOMMENDED workload set, which includes Android/MAUI/Unreal/Unity/Mono/Linux mobile+game workloads that this project (a Python+Rust quant bot) does not use"
    },
    "theOptimization": {
      "rootCause": "the trigger is the scheduled task '\\\\Microsoft\\\\VisualStudio\\\\Updates\\\\BackgroundDownload' firing on a 10-minute idle trigger, on an instance whose includeRecommended=1",
      "lever1_disableTheTrigger": "disable the scheduled task + set BackgroundDownloadDisabled=1 on all three registry policy layers -> the run never starts, so nothing is downloaded at all",
      "lever2_shrinkTheScope": "turn OFF includeRecommended for instance 968a13cd so the recommended workload set (Android/MAUI/Unreal/Unity/Mono/Linux) is not advertised for download",
      "lever3_dropTheEolInstance": "238f66ce is VS 2019 BuildTools 16.11 (EOL) and alone accounts for 1224.41 of the 1296.82 GiB counter; uninstalling it removes the largest source",
      "lever4_leaveTheDiskCacheAlone": "the 9.94 GB package cache is small and is NOT the problem; deleting it only forces a re-download, so it is optional, not a fix",
      "recommendedOrder": [
        "lever1 (stop the trigger)",
        "lever3 (remove the EOL instance)",
        "lever2 (drop recommended workloads)",
        "lever4 (optional cache cleanup)"
      ],
      "expectedEffect": "lever1 alone takes the recurring network+install churn to zero; lever2+lever3 stop the workload set from being re-advertised at all",
      "whatDoesNotHelp": "deleting the 9.94 GB cache (it is not the 1296 GiB), and raising the idle trigger interval (it only slows the recurrence, it does not remove the re-download of the same 482 packages)"
    }
  },
