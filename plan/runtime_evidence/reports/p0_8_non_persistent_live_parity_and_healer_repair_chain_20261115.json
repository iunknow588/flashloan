  "defectsFoundAndFixed": [
    {
      "detail": "the review-time pool id was lowercased while the request pool ids and the live snapshot kept the original case, so a live route was silently dropped and reported as not_comparable",
      "fix": "pool ids are normalized to lower case on every side (request extraction, live snapshot map, review-time map, build_hops lookup)",
      "id": "pool-id-case-mismatch",
      "regressionTest": "the_pool_id_is_matched_regardless_of_its_case",
      "severity": "blocking"
    },
    {
      "detail": "pool_manager::depth used an unchecked U256 -> u128 cast, so a chain value above 128 bits panicked and aborted the process that asked for a measurement",
      "fix": "to_u128_checked reports the overflow as an error; the measurement never panics",
      "id": "u256-to-u128-panic",
      "regressionTest": "an_amount_that_does_not_fit_in_128_bits_is_an_error_and_not_a_panic",
      "severity": "blocking"
    },
    {
      "detail": "a missing live snapshot table aborted the whole parity replay, even though the review-time state alone carries a complete route",
      "fix": "the live snapshot is only a fallback; an unreadable snapshot degrades to the review-time state",
      "id": "missing-live-snapshot-aborted-replay",
      "regressionTest": "a_live_payload_replay_survives_a_missing_live_snapshot",
      "severity": "blocking"
    },
    {
      "detail": "the healer hard-coded the broadcast layer as skipped, so a failed broadcast was never diagnosed or repaired",
      "fix": "BROADCAST_FAILURE_CLASSES classifies the failure and repair_broadcast_failures drives the broadcast manager",
      "id": "broadcast-repair-missing",
      "regressionTest": "test_a_failed_broadcast_is_finalized_by_the_broadcast_manager",
      "severity": "blocking"
    },
    {
      "detail": "the missing-profit repair was a single pass, so a review could stay without an explicit value forever",
      "fix": "converge_reviews drives a bounded loop and reports a stall instead of a success",
      "id": "review-convergence-missing",
      "regressionTest": "test_the_convergence_reports_a_stall_instead_of_a_success",
      "severity": "blocking"
    },
    {
      "detail": "the classifier matched snake_case markers against prose, so 'out of gas' was reported as unknown",
      "fix": "spaces, dashes and underscores are collapsed to one separator before the match",
      "id": "broadcast-classifier-separator-mismatch",
      "regressionTest": "test_a_rejected_transaction_is_a_defect",
      "severity": "major"
    }
  ],
