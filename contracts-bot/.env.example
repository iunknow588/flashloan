# 部署钱包私钥。
# 作用：Hardhat 在部署合约、执行 fork 测试、发起主网交易时使用的签名账户。
# 注意：不要提交真实私钥到 git；建议只放本地开发环境。
DEPLOYER_PRIVATE_KEY=

# =========================
# Avalanche 主网配置
# =========================

# Avalanche 主网 RPC。
# 作用：连接主网、部署合约、读取链上状态、执行 simulate/staticCall。
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Fork 时可指定主网区块号。
# 作用：让本地 hardhat fork 固定在某个历史区块，便于复现问题。
# 留空表示使用最新区块。
AVALANCHE_FORK_BLOCK=

# Aave V3 Pool 地址。
# 作用：清算执行器会从这里发起 flashLoanSimple，并在回调中调用 liquidationCall。
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1db02a252b5b4814aD

# DEX Router 地址。
# 作用：合约清算后会把拿到的抵押资产通过这个 Router 换回 USDC。
# 需要与目标网络的真实 Router 地址一致。
DEX_ROUTER_ADDRESS=0x60aE616a2155Ee3d9A68541Ba4544862310933d4

# USDC 地址。
# 作用：执行器把所有利润统一归集到 USDC，再由 owner 提走。
# 这里应填写目标网络上的 USDC 合约地址。
USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E

# 已部署的执行器地址。
# 作用：simulate:liquidation 会读取这个地址，对已部署合约做 staticCall 预检。
# 如果还没部署可以先留空。
LIQUIDATION_EXECUTOR_ADDRESS=

# 清算请求 JSON。
# 作用：simulate:liquidation 的输入请求体，脚本会把它转成合约的 LiquidationRequest。
# 可以直接写一整段 JSON，也可以通过 --payload 从文件读取。
# 注意：所有数值字段都按最小单位填写，不要写成人类可读格式。
#   - debtToCover / minCollateralSwapOut / minProfitAmount：整数字符串
#   - deadline：Unix 时间戳字符串
#   - swapPath：地址数组，首尾必须分别是 collateralAsset 和 debtAsset
#
# 示例：
# LIQUIDATION_REQUEST_JSON={"user":"0x...","collateralAsset":"0x...","debtAsset":"0x...","debtToCover":"1000000","minCollateralSwapOut":"0","minProfitAmount":"0","deadline":"9999999999","swapPath":["0x...","0x..."]}
LIQUIDATION_REQUEST_JSON=

# =========================
# Fuji 测试网配置
# =========================

# Fuji RPC。
# 作用：部署到测试网、做测试网 fork 或读取 Fuji 状态。
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Fuji 上的 Aave Pool 地址。
# 作用：用于 Fuji 部署、Fuji fork 测试和 Fuji staticCall 模拟。
FUJI_AAVE_POOL_ADDRESS=0x8B9b2AF4afB389b4a70A474dfD4AdCD4a302bb40

# Fuji 上的 DEX Router 地址。
# 作用：用于 Fuji 清算后的抵押品兑换回 USDC。
FUJI_DEX_ROUTER_ADDRESS=0xd7f655E3376cE2D7A2b08fF01Eb3B1023191A901

# Fuji 上的 USDC 地址。
# 作用：用于 Fuji 上的利润归集与提现基准币。
FUJI_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
