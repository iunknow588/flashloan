# Dedicated Avalanche Fuji RPC. Do not use public RPC to evaluate execution.
FUJI_RPC_URL=https://your-dedicated-fuji-rpc.example

# Deployer / test executor key. Never commit a real .env file.
DEPLOYER_PRIVATE_KEY=0xyour_private_key

# Filled after deployment.
MOCK_EXECUTOR_ADDRESS=0x...
AAVE_POOL_ADDRESS=0x...
AAVE_EXECUTOR_ADDRESS=0x...
ONCHAIN_DYNAMIC_AAVE_EXECUTOR_ADDRESS=0x...

# Option A: use scripts/deploy-fuji-test-fixture.js to deploy mock tokens/router.
# Option B: use a real Fuji DEX router and real test token addresses confirmed from the target DEX docs.
FUJI_DEX_ROUTER=0x...
FUJI_USDC=0x...
FUJI_ROUNDTRIP_TOKEN=0x...

# Dynamic on-chain decision executor. The off-chain process only passes x/y.
DYNAMIC_SIGNAL_FILE=../flashloan/srcs/runtime/state/latest_executable_signal.json
DYNAMIC_DEX_ROUTER=0x...
DYNAMIC_USDC=0x...
DYNAMIC_BORROW_AMOUNT_UNITS=1000000000000000000
DYNAMIC_AMOUNT_X_UNITS=1000000000000000000
DYNAMIC_AMOUNT_Y_UNITS=1000000000000000000
DYNAMIC_AAVE_PREMIUM_BPS=5
DYNAMIC_MIN_PROFIT_USDC_UNITS=1
DYNAMIC_SLIPPAGE_BPS=50
DYNAMIC_DEADLINE_SECONDS=60

# Token address mapping for trigger symbols. Use Fuji/fork addresses, not Binance addresses.
DYNAMIC_TOKEN_AVAXUSDT=0x...
DYNAMIC_TOKEN_ETHUSDT=0x...
DYNAMIC_TOKEN_BTCUSDT=0x...
DYNAMIC_TOKEN_AAVEUSDT=0x...

# Raw token units. Example for 1 USDC with 6 decimals: 1000000.
FUJI_USDC_AMOUNT_UNITS=1000000
FUJI_FIRST_MIN_OUT_UNITS=1
FUJI_FINAL_MIN_OUT_UNITS=1
FUJI_MIN_PROFIT_UNITS=0
FUJI_DEADLINE_SECONDS=600

# Local execution log, used by the control panel stats reader.
TESTNET_TRADE_LOG=deployments/fuji-trades.jsonl
EXECUTION_PAYLOAD_FILE=deployments/execution-payload.json
